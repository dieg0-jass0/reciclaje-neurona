<main class="auth">
  <form class="panel auth-form" method="post" action="/login">
    <h1>Iniciar sesión</h1>
    {{#if exito}}<p class="alerta ok">{{exito}}</p>{{/if}}
    {{#if error}}<p class="alerta error">{{error}}</p>{{/if}}

    <label for="numeroControl">Número de control</label>
    <input id="numeroControl" name="numeroControl" value="{{valores.numeroControl}}" required autofocus autocomplete="username">

    <label for="password">Contraseña</label>
    <input id="password" name="password" type="password" required autocomplete="current-password">

    <button type="submit">Entrar</button>
    <p class="auth-pie">¿No tienes cuenta? <a href="/registro">Regístrate</a></p>
  </form>
</main>
