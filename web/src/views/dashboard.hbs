<main class="contenedor">
  <header class="barra">
    <h1>Clasificador de botellas de plástico</h1>
    <div class="usuario">
      {{#if esAdmin}}<a href="/admin" class="dash-enlace">Administrador</a>{{/if}}
      <span>Hola, <strong>{{usuario}}</strong></span>
      <form method="post" action="/logout">
        <button type="submit" class="boton secundario">Cerrar sesión</button>
      </form>
    </div>
  </header>

  <div id="avisoSesion" class="mensaje alerta" role="alert" hidden
       data-inactividad-ms="{{inactividadMs}}"></div>
  <p class="nota">La sesión se cierra tras {{textoInactividad}} sin actividad.</p>

  <section class="panel">
    <label for="camaras">Cámara:</label>
    <select id="camaras"></select>
    <span id="estadoIA" class="chip">IA: ...</span>
  </section>

  <section class="grid">
    <div class="panel">
      <video id="video" autoplay muted playsinline></video>
      <div id="resultado" class="resultado">Esperando cámara...</div>
    </div>

    <div class="panel">
      <h2>Resumen</h2>
      <p>Total analizados: <strong id="total">0</strong></p>
      <p>Botellas: <strong id="botellas">0</strong></p>
      <p>No botellas: <strong id="noBotellas">0</strong></p>
      <h2>Últimas detecciones</h2>
      <ul id="historial" class="historial"></ul>
    </div>
  </section>
</main>
<script src="/js/sesion.js"></script>
<script src="/js/camara.js"></script>