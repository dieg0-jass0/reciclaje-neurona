<div class="dash">
  <header class="dash-barra">
    <div class="dash-marca">
      <h1>Administrador</h1>
    </div>
    <div class="dash-usuario">
      <a href="/" class="dash-enlace">Ir al escáner</a>
      <span class="dash-nombre">{{usuario}}</span>
      <form method="post" action="/logout">
        <button type="submit" class="dash-salir">Cerrar sesión</button>
      </form>
    </div>
  </header>

  <main class="dash-contenido">
    <div id="avisoSesion" class="mensaje alerta" role="alert" hidden
         data-inactividad-ms="{{inactividadMs}}"></div>
    {{#if aviso}}<p class="mensaje info admin-aviso">{{aviso}}</p>{{/if}}

    <section class="admin-stats">
      <div class="dash-stat"><span>Usuarios</span><strong>{{totalUsuarios}}</strong></div>
      <div class="dash-stat"><span>Administradores</span><strong>{{totalAdmins}}</strong></div>
      <div class="dash-stat si"><span>Botellas recicladas</span><strong>{{resumen.botellas}}</strong></div>
      <div class="dash-stat"><span>Puntos entregados</span><strong>{{resumen.puntos}}</strong></div>
    </section>

    <section class="dash-tarjeta admin-carreras">
      <h2>Usuarios por carrera</h2>
      <ul>
        {{#each porCarrera}}
          <li><span>{{nombre}}</span><strong>{{total}}</strong></li>
        {{/each}}
      </ul>
    </section>

    <section class="dash-tarjeta">
      <div class="admin-cabeza">
        <h2>Usuarios registrados</h2>
        <a href="{{enlacePdf}}" class="boton">Descargar PDF</a>
      </div>

      <form class="admin-filtros" method="get" action="/admin">
        <input type="search" name="buscar" value="{{buscar}}" placeholder="Buscar por número de control, nombre o correo">
        <select name="rol">
        <option value="">Todos los tipos</option>
        <option value="usuario" {{#if rolUsuario}}selected{{/if}}>Usuarios</option>
        <option value="admin" {{#if rolAdmin}}selected{{/if}}>Administradores</option>
      </select>
        <select name="carrera">
          <option value="">Todas las carreras</option>
          {{#each carreras}}
            <option value="{{nombre}}" {{#if seleccionada}}selected{{/if}}>{{nombre}}</option>
          {{/each}}
        </select>
        <button type="submit" class="dash-salir">Filtrar</button>
        {{#if hayFiltros}}<a href="/admin" class="admin-limpiar">Quitar filtros</a>{{/if}}
      </form>

      <div class="admin-tabla-contenedor">
        <table class="admin-tabla">
          <thead>
            <tr>
              <th>No. control</th>
              <th>Tipo</th>
              <th>Nombre completo</th>
              <th>Correo</th>
              <th>Carrera</th>
              <th>Registro</th>
              <th class="num">Botellas</th>
              <th class="num">Puntos</th>
              <th>Reporte</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {{#each usuarios}}
              <tr>
                <td>{{numeroControl}}</td>
                <td><span class="etiqueta-rol {{#if esAdminFila}}admin{{/if}}">{{tipo}}</span></td>
                <td>{{nombre}}</td>
                <td>{{correo}}</td>
                <td>{{carrera}}</td>
                <td>{{registro}}</td>
                <td class="num">{{botellas}}</td>
                <td class="num">{{puntos}}</td>
                <td><a class="dash-enlace" href="/admin/usuarios/{{id}}/reporte.pdf" download>Reporte PDF</a></td>
                <td class="num">
                  {{#if soyYo}}
                    <span class="admin-tu">Tú</span>
                  {{else}}
                    <form method="post" action="/admin/usuarios/{{id}}/eliminar"
                          onsubmit="return confirm('¿Eliminar al usuario {{numeroControl}}?');">
                      <button type="submit" class="admin-eliminar">Eliminar</button>
                    </form>
                  {{/if}}
                </td>
              </tr>
            {{else}}
              <tr><td colspan="10" class="admin-vacio">No hay usuarios que coincidan.</td></tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </section>

    <p class="dash-nota">La sesión se cierra tras {{textoInactividad}} sin actividad.</p>
  </main>
</div>
<script src="/js/sesion.js"></script>