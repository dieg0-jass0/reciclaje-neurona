<main class="contenedor-auth">
  <form class="tarjeta-auth ancha" method="post" action="/registro">
    <div class="encabezado-auth">
      <h1>Crear cuenta</h1>
      <p>Regístrate para empezar a escanear botellas</p>
    </div>

    {{#if error}}<p class="mensaje error">{{error}}</p>{{/if}}

    <div class="tipo-acceso" role="radiogroup" aria-label="Tipo de cuenta">
      <input type="radio" id="tipoUsuario" name="tipo" value="usuario" {{#unless comoAdmin}}checked{{/unless}}>
      <label for="tipoUsuario">Usuario</label>
      <input type="radio" id="tipoAdmin" name="tipo" value="admin" {{#if comoAdmin}}checked{{/if}}>
      <label for="tipoAdmin">Administrador</label>
    </div>

    <div class="campo">
      <label for="numeroControl">Número de control</label>
      <input id="numeroControl" name="numeroControl" value="{{numeroControl}}" autocomplete="username"
             pattern="[A-Za-z0-9]{4,15}" title="De 4 a 15 letras o números, sin espacios"
             placeholder="Ej. 20210123" required autofocus>
    </div>

    <div class="campo">
      <label for="nombreCompleto">Nombre completo</label>
      <input id="nombreCompleto" name="nombreCompleto" value="{{nombreCompleto}}" autocomplete="name"
             minlength="3" maxlength="100" placeholder="Nombre y apellidos" required>
    </div>

    <div class="campo">
      <label for="correo">Correo electrónico</label>
      <input id="correo" name="correo" type="email" value="{{correo}}" autocomplete="email"
             placeholder="tucorreo@ejemplo.com" required>
    </div>

    <!-- Solo para usuarios -->
    <div class="campo" id="campoCarrera">
      <label for="carrera">Carrera</label>
      <select id="carrera" name="carrera" required>
        <option value="" disabled selected>Selecciona tu carrera</option>
        {{#each carreras}}
          <option value="{{nombre}}" {{#if seleccionada}}selected{{/if}}>{{nombre}}</option>
        {{/each}}
      </select>
    </div>

    <!-- Solo para administradores -->
    <div class="campo" id="campoCodigo" hidden>
      <label for="codigoAdmin">Código de administrador</label>
      <input id="codigoAdmin" name="codigoAdmin" type="password" autocomplete="off"
             placeholder="Te lo proporciona el responsable del sistema">
    </div>

    <div class="fila-auth">
      <div class="campo">
        <label for="password">Contraseña</label>
        <input id="password" name="password" type="password" autocomplete="new-password"
               minlength="{{minPassword}}" placeholder="Mínimo {{minPassword}} caracteres" required>
      </div>
      <div class="campo">
        <label for="confirmar">Confirmar contraseña</label>
        <input id="confirmar" name="confirmar" type="password" autocomplete="new-password"
               minlength="{{minPassword}}" placeholder="Repite la contraseña" required>
      </div>
    </div>

    <button type="submit" class="boton boton-auth">Crear cuenta</button>
    <p class="pie-auth">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
  </form>
</main>

<script>
  // Muestra "Carrera" para usuarios y "Código de administrador" para admins
  (() => {
    const admin = document.getElementById('tipoAdmin');
    const campoCarrera = document.getElementById('campoCarrera');
    const campoCodigo = document.getElementById('campoCodigo');
    const carrera = document.getElementById('carrera');
    const codigo = document.getElementById('codigoAdmin');
    function actualizar() {
      const esAdmin = admin.checked;
      campoCarrera.hidden = esAdmin;
      carrera.required = !esAdmin;
      carrera.disabled = esAdmin;
      campoCodigo.hidden = !esAdmin;
      codigo.required = esAdmin;
      codigo.disabled = !esAdmin;
    }
    document.querySelectorAll('input[name="tipo"]').forEach((r) => r.addEventListener('change', actualizar));
    actualizar();
  })();
</script>