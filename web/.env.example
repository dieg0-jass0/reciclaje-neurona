PORT=3000
IA_URL=http://127.0.0.1:5000

# MongoDB local:
MONGODB_URI=mongodb://127.0.0.1:27017/reciclaje
# MongoDB Atlas (reemplaza usuario, contrasena y cluster):
# MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/reciclaje?retryWrites=true&w=majority

# Clave para firmar las sesiones (pon cualquier texto largo y aleatorio)
SESSION_SECRET=pon-aqui-un-texto-largo-y-aleatorio

# Conteo de botellas (una botella = un conteo, aunque aparezca en muchos frames)
PUNTOS_POR_BOTELLA=10
# Seguridad mínima del modelo para aceptar una botella (0 a 1)
CONTEO_CONFIANZA_MIN=0.8
# Frames seguidos con botella para contarla (la cámara manda 1 frame por segundo)
CONTEO_FRAMES_CONFIRMAR=2
# Frames seguidos sin botella para poder contar la siguiente (la persona la retiró o la depositó)
CONTEO_FRAMES_LIBERAR=3
# Segundos mínimos entre dos botellas de la misma persona
CONTEO_ESPERA_SEG=3

# Correo (aviso de registro y constancia de reciclaje que se envía al usuario).
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 y una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
